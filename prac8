// Authentication state exists only for the current page session.
let loggedInCredentials = null;
let currentRole = null;

const loginScreen = document.getElementById("loginScreen");
const appShell = document.getElementById("appShell");
const authForm = document.getElementById("authForm");
const authMessage = document.getElementById("authMessage");
const loginButton = document.getElementById("loginButton");

const petForm = document.getElementById("dbPetForm");
const petListContainer = document.getElementById("availablePetsList");
const petDbMessage = document.getElementById("petDbMessage");

// Always attach credentials to protected API requests.
function apiFetch(url, options = {}) {
    if (!loggedInCredentials) {
        throw new Error("Please log in first.");
    }

    const headers = {
        ...(options.headers || {}),
        username: loggedInCredentials.username,
        password: loggedInCredentials.password
    };

    return fetch(url, { ...options, headers });
}

async function readResponse(response) {
    const result = await response.json();

    if (!response.ok) {
        if (response.status === 401) {
            logout("Your login is no longer valid. Please log in again.");
        }

        throw new Error(
            result.error || result.message || "The request failed."
        );
    }

    return result;
}

// Login
authForm.addEventListener("submit", async function(event) {
    event.preventDefault();

    const username =
        document.getElementById("authUsername").value.trim();

    const password =
        document.getElementById("authPassword").value;

    loginButton.disabled = true;
    authMessage.textContent = "Checking login details...";

    // Keep the website hidden while credentials are checked.
    loggedInCredentials = null;
    currentRole = null;
    appShell.hidden = true;

    try {
        const response = await fetch("/api/profile", {
            headers: { username, password }
        });

        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.message || "Login failed.");
        }

        loggedInCredentials = { username, password };
        currentRole = result.role;

        // Reveal the website only after successful authentication.
        loginScreen.hidden = true;
        appShell.hidden = false;

        // Admins can manage pets; regular users can only view them.
        petForm.hidden = currentRole !== "admin";

        const registerButton = document.querySelector(
            '[data-bs-target="#registrationModal"]'
        );

        if (registerButton) {
            registerButton.hidden = currentRole !== "admin";
        }

        await loadDatabasePets();

    } catch (error) {
        loggedInCredentials = null;
        currentRole = null;

        loginScreen.hidden = false;
        appShell.hidden = true;

        authMessage.textContent = error.message;
    } finally {
        loginButton.disabled = false;
    }
});

// Logout
function logout(message = "You have logged out.") {
    loggedInCredentials = null;
    currentRole = null;

    authForm.reset();
    appShell.hidden = true;
    loginScreen.hidden = false;
    petForm.hidden = true;

    authMessage.textContent = message;
    petDbMessage.textContent = "";
    petListContainer.replaceChildren();

    // Also close the registration modal if it is open.
    const modalElement = document.getElementById("registrationModal");

    if (modalElement && window.bootstrap) {
        const modal = bootstrap.Modal.getInstance(modalElement);
        if (modal) modal.hide();
    }
}

// Add a logout button to the website header.
const logoutButton = document.createElement("button");
logoutButton.type = "button";
logoutButton.id = "websiteLogout";
logoutButton.textContent = "Logout";
logoutButton.addEventListener("click", () => logout());

document.querySelector("#appShell header").appendChild(logoutButton);

// Map existing local images to pet species.
function getPetImage(pet) {
    const text = (pet.name + " " + pet.species).toLowerCase();

    if (text.includes("persian")) return "cat.jpg";
    if (text.includes("grey cat") || text.includes("gray cat")) {
        return "cat2.jpg";
    }
    if (text.includes("british shorthair")) return "cat3.jpg";
    if (text.includes("cat")) return "cat.jpg";
    if (text.includes("pomeranian")) return "dog2.jpg";
    if (text.includes("chow chow")) return "dog3.jpg";
    if (text.includes("shih tzu")) return "dog4.jpg";
    if (text.includes("dog") || text.includes("maltipoo")) {
        return "dog.jpg";
    }

    return text.includes("kitten") ? "cat.jpg" : "dog.jpg";
}

// Load pets from the MySQL database into Available Pets.
async function loadDatabasePets() {
    if (!loggedInCredentials) return;

    petListContainer.textContent = "Loading pets...";
    petDbMessage.textContent = "";

    try {
        const response = await apiFetch("/api/pets");
        const pets = await readResponse(response);

        petListContainer.replaceChildren();

        // Users see available pets only. Admins can also see adopted pets.
        const visiblePets = currentRole === "admin"
            ? pets
            : pets.filter(pet => pet.status === "Available");

        if (visiblePets.length === 0) {
            petListContainer.textContent = currentRole === "admin"
                ? "No pet records yet. Add your first pet above."
                : "No pets are currently available for adoption.";
            return;
        }

        visiblePets.forEach(pet => {
            const card = document.createElement("article");
            card.className = "card";
            card.draggable = pet.status === "Available";

            const image = document.createElement("img");
            image.src = getPetImage(pet);
            image.alt = pet.name;
            image.loading = "lazy";

            const heading = document.createElement("h3");
            heading.textContent = pet.name;

            const species = document.createElement("p");
            species.textContent = "Species / Breed: " + pet.species;

            const age = document.createElement("p");
            age.textContent = "Age: " + pet.age_months + " months";

            const status = document.createElement("p");
            status.textContent = "Status: " + pet.status;
            status.className = pet.status === "Available"
                ? "pet-status available"
                : "pet-status adopted";

            card.append(image, heading, species, age, status);

            // Only admins get management controls.
            if (currentRole === "admin") {
                const editButton = document.createElement("button");
                editButton.type = "button";
                editButton.textContent = "Edit Pet";
                editButton.addEventListener("click", () => editPet(pet));

                const statusButton = document.createElement("button");
                statusButton.type = "button";
                statusButton.textContent = pet.status === "Available"
                    ? "Mark Adopted"
                    : "Mark Available";

                statusButton.addEventListener("click", () => {
                    updatePet(pet, {
                        name: pet.name,
                        species: pet.species,
                        age_months: pet.age_months,
                        status: pet.status === "Available"
                            ? "Adopted"
                            : "Available"
                    });
                });

                const deleteButton = document.createElement("button");
                deleteButton.type = "button";
                deleteButton.textContent = "Delete Pet";
                deleteButton.className = "delete-pet";

                deleteButton.addEventListener("click", async () => {
                    if (!confirm("Permanently delete " + pet.name + "?")) {
                        return;
                    }

                    try {
                        const response = await apiFetch(
                            "/api/pets/" + pet.id,
                            { method: "DELETE" }
                        );

                        const result = await readResponse(response);
                        petDbMessage.textContent = result.message;
                        await loadDatabasePets();
                    } catch (error) {
                        petDbMessage.textContent = error.message;
                    }
                });

                card.append(editButton, statusButton, deleteButton);
            }

            card.addEventListener("dragstart", event => {
                if (pet.status !== "Available") {
                    event.preventDefault();
                    return;
                }

                event.dataTransfer.setData("text/plain", pet.name);
            });

            petListContainer.appendChild(card);
        });

    } catch (error) {
        petListContainer.textContent = error.message;
    }
}

// Admin: edit an existing pet's details.
async function editPet(pet) {
    const name = prompt("Pet name:", pet.name);
    if (name === null) return;

    const species = prompt("Species / breed:", pet.species);
    if (species === null) return;

    const ageInput = prompt("Age in months:", pet.age_months);
    if (ageInput === null) return;

    const age = Number(ageInput);

    if (
        !name.trim() ||
        !species.trim() ||
        !Number.isInteger(age) ||
        age < 0 ||
        age > 600
    ) {
        petDbMessage.textContent =
            "Enter a valid name, species and age between 0 and 600.";
        return;
    }

    await updatePet(pet, {
        name: name.trim(),
        species: species.trim(),
        age_months: age,
        status: pet.status
    });
}

// Admin: update a pet in MySQL.
async function updatePet(pet, details) {
    try {
        const response = await apiFetch("/api/pets/" + pet.id, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(details)
        });

        const result = await readResponse(response);
        petDbMessage.textContent = result.message;
        await loadDatabasePets();
    } catch (error) {
        petDbMessage.textContent = error.message;
    }
}

// Admin: add a pet to MySQL.
petForm.addEventListener("submit", async function(event) {
    event.preventDefault();

    if (currentRole !== "admin") {
        petDbMessage.textContent = "Only administrators can add pets.";
        return;
    }

    const name = document.getElementById("dbPetName").value.trim();
    const species = document.getElementById("dbPetSpecies").value.trim();
    const age = Number(document.getElementById("dbPetAge").value);

    try {
        const response = await apiFetch("/api/pets", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                name,
                species,
                age_months: age
            })
        });

        const result = await readResponse(response);
        petDbMessage.textContent =
            result.message + " Pet ID: " + result.id;

        petForm.reset();
        await loadDatabasePets();
    } catch (error) {
        petDbMessage.textContent = error.message;
    }
});

document.getElementById("refreshPets").addEventListener(
    "click",
    loadDatabasePets
);

/* EXISTING WEBSITE FEATURES */

// Featured pet information
function showInfo() {
    const info = document.getElementById("petInfo");

    info.textContent = info.textContent
        ? ""
        : "Maltipoos are friendly, intelligent and playful dogs. " +
          "They are affectionate companions and love spending time " +
          "with their families. Take him home with you today!";
}

// Adoption wishlist
function addPet() {
    const input = document.getElementById("petInput");
    const pet = input.value.trim();

    if (!pet) {
        alert("Please enter a pet name.");
        return;
    }

    const li = document.createElement("li");
    const name = document.createElement("span");
    name.textContent = pet;

    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "remove";
    remove.textContent = "Remove";
    remove.addEventListener("click", () => {
        li.remove();
        savePets();
    });

    li.append(name, remove);
    document.getElementById("petList").appendChild(li);
    input.value = "";
    savePets();
}

function savePets() {
    const pets = Array.from(
        document.querySelectorAll("#petList li span")
    ).map(span => span.textContent);

    localStorage.setItem("pets", JSON.stringify(pets));
}

function loadPets() {
    let pets = [];

    try {
        pets = JSON.parse(localStorage.getItem("pets")) || [];
    } catch {
        pets = [];
    }

    document.getElementById("petList").replaceChildren();

    pets.forEach(pet => {
        const input = document.getElementById("petInput");
        input.value = pet;
        addPet();
    });

    document.getElementById("petInput").value = "";
}

// Location
function getLocation() {
    if (!navigator.geolocation) {
        document.getElementById("location").textContent =
            "Geolocation is not supported.";
        return;
    }

    navigator.geolocation.getCurrentPosition(
        showPosition,
        () => {
            document.getElementById("location").textContent =
                "Unable to retrieve your location.";
        }
    );
}

function showPosition(position) {
    document.getElementById("location").textContent =
        "Latitude: " + position.coords.latitude +
        " | Longitude: " + position.coords.longitude;
}

// Drag and drop target
const dropBox = document.getElementById("dropBox");

if (dropBox) {
    dropBox.addEventListener("dragover", event => {
        event.preventDefault();
    });

    dropBox.addEventListener("drop", event => {
        event.preventDefault();

        const petName = event.dataTransfer.getData("text/plain");
        if (!petName) return;

        dropBox.textContent = "Selected pet: " + petName;
    });
}

// Student registration form
document.getElementById("registrationForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        alert("Registration successful!");

        const modal = bootstrap.Modal.getInstance(
            document.getElementById("registrationModal")
        );

        if (modal) modal.hide();
        this.reset();
    }
);

// Load wishlist only. Do not fetch the pet database before login.
loadPets();

