const express = require("express");
const mysql = require("mysql");
const path = require("path");

const app = express();
const PORT = 3000;

app.use(express.json());

// Serve static assets, but the HTML itself is served explicitly below.
app.use(express.static(__dirname, { index: false }));

const users = [
    { username: "admin", password: "1234", role: "admin" },
    { username: "student", password: "1234", role: "user" }
];

const connection = mysql.createConnection({
    host: "localhost",
    user: "root",
    password: ""
});

let databaseReady = false;

// Authentication from request headers.
function authenticate(req, res, next) {
    const username = req.headers.username;
    const password = req.headers.password;

    const user = users.find(
        u => u.username === username && u.password === password
    );

    if (!user) {
        return res.status(401).json({
            message: "Authentication failed. Please log in."
        });
    }

    req.authenticatedUser = {
        username: user.username,
        role: user.role
    };

    next();
}

// Admin-only authorization.
function requireAdmin(req, res, next) {
    if (req.authenticatedUser.role !== "admin") {
        return res.status(403).json({
            message: "Access denied. Admin only."
        });
    }

    next();
}

// Serve the login page.
app.get("/", (req, res) => {
    res.sendFile(path.join(__dirname, "index.html"));
});

// Login/profile verification.
app.get("/api/profile", authenticate, (req, res) => {
    res.json({
        message: "Login successful",
        user: req.authenticatedUser.username,
        role: req.authenticatedUser.role
    });
});

// Optional practical/exercise routes.
app.get("/admin", authenticate, requireAdmin, (req, res) => {
    res.json({
        message: "Welcome Admin!",
        user: req.authenticatedUser.username,
        role: req.authenticatedUser.role
    });
});

app.get("/user", authenticate, (req, res) => {
    res.json({
        message: "Login successful",
        user: req.authenticatedUser.username,
        role: req.authenticatedUser.role
    });
});

// Check database availability for API requests.
function requireDatabase(req, res, next) {
    if (!databaseReady) {
        return res.status(503).json({
            error: "The pet database is not ready yet."
        });
    }

    next();
}

// Read pets: any authenticated user can view the database.
app.get("/api/pets", authenticate, requireDatabase, (req, res) => {
    connection.query(
        "SELECT * FROM pets ORDER BY id DESC",
        (err, results) => {
            if (err) {
                return res.status(500).json({
                    error: "Could not load pets."
                });
            }

            res.json(results);
        }
    );
});

// Add a pet: administrators only.
app.post(
    "/api/pets",
    authenticate,
    requireAdmin,
    requireDatabase,
    (req, res) => {
        const { name, species, age_months } = req.body;

        if (
            typeof name !== "string" ||
            !name.trim() ||
            typeof species !== "string" ||
            !species.trim() ||
            !Number.isInteger(age_months) ||
            age_months < 0 ||
            age_months > 600
        ) {
            return res.status(400).json({
                error: "Enter a valid name, species and age (0–600 months)."
            });
        }

        connection.query(
            "INSERT INTO pets (name, species, age_months) VALUES (?, ?, ?)",
            [name.trim(), species.trim(), age_months],
            (err, result) => {
                if (err) {
                    return res.status(500).json({
                        error: "Could not add the pet."
                    });
                }

                res.status(201).json({
                    message: "Pet added successfully.",
                    id: result.insertId
                });
            }
        );
    }
);

// Edit pet details and status: administrators only.
app.put(
    "/api/pets/:id",
    authenticate,
    requireAdmin,
    requireDatabase,
    (req, res) => {
        const id = Number(req.params.id);
        const { name, species, age_months, status } = req.body;

        if (
            !Number.isInteger(id) ||
            id < 1 ||
            typeof name !== "string" ||
            !name.trim() ||
            typeof species !== "string" ||
            !species.trim() ||
            !Number.isInteger(age_months) ||
            age_months < 0 ||
            age_months > 600 ||
            !["Available", "Adopted"].includes(status)
        ) {
            return res.status(400).json({
                error: "Enter valid pet details and adoption status."
            });
        }

        connection.query(
            `UPDATE pets
             SET name = ?, species = ?, age_months = ?, status = ?
             WHERE id = ?`,
            [name.trim(), species.trim(), age_months, status, id],
            (err, result) => {
                if (err) {
                    return res.status(500).json({
                        error: "Could not update the pet."
                    });
                }

                if (result.affectedRows === 0) {
                    return res.status(404).json({
                        error: "Pet not found."
                    });
                }

                res.json({ message: "Pet updated successfully." });
            }
        );
    }
);

// Delete a pet: administrators only.
app.delete(
    "/api/pets/:id",
    authenticate,
    requireAdmin,
    requireDatabase,
    (req, res) => {
        const id = Number(req.params.id);

        if (!Number.isInteger(id) || id < 1) {
            return res.status(400).json({ error: "Invalid pet ID." });
        }

        connection.query(
            "DELETE FROM pets WHERE id = ?",
            [id],
            (err, result) => {
                if (err) {
                    return res.status(500).json({
                        error: "Could not delete the pet."
                    });
                }

                if (result.affectedRows === 0) {
                    return res.status(404).json({
                        error: "Pet not found."
                    });
                }

                res.json({ message: "Pet deleted successfully." });
            }
        );
    }
);

// Database setup and server startup.
connection.connect(err => {
    if (err) {
        console.error("MySQL connection failed:", err.message);
        process.exit(1);
    }

    console.log("Connected to MySQL.");

    connection.query(
        "CREATE DATABASE IF NOT EXISTS pet_adoption",
        err => {
            if (err) {
                console.error("Database creation failed:", err.message);
                process.exit(1);
            }

            connection.query("USE pet_adoption", err => {
                if (err) {
                    console.error("Could not select database:", err.message);
                    process.exit(1);
                }

                connection.query(
                    `CREATE TABLE IF NOT EXISTS pets (
                        id INT AUTO_INCREMENT PRIMARY KEY,
                        name VARCHAR(100) NOT NULL,
                        species VARCHAR(50) NOT NULL,
                        age_months INT NOT NULL,
                        status VARCHAR(30) DEFAULT 'Available'
                    )`,
                    err => {
                        if (err) {
                            console.error("Table creation failed:", err.message);
                            process.exit(1);
                        }

                        // Seed the original example pets only if the table
                        // is empty. Existing database records are preserved.
                        connection.query(
                            "SELECT COUNT(*) AS total FROM pets",
                            (err, rows) => {
                                if (err) {
                                    console.error(err.message);
                                    process.exit(1);
                                }

                                const startServer = () => {
                                    databaseReady = true;

                                    app.listen(PORT, () => {
                                        console.log(
                                            `Website running at http://localhost:${PORT}`
                                        );
                                    });
                                };

                                if (rows[0].total > 0) {
                                    return startServer();
                                }

                                const starterPets = [
                                    ["Maltipoo", "Dog", 2],
                                    ["Pomeranian", "Dog", 4],
                                    ["Chow Chow", "Dog", 6],
                                    ["Shih Tzu", "Dog", 5],
                                    ["Persian Cat", "Cat", 2],
                                    ["Grey Cat", "Cat", 3],
                                    ["British Shorthair", "Cat", 5]
                                ];

                                connection.query(
                                    `INSERT INTO pets
                                     (name, species, age_months)
                                     VALUES ?`,
                                    [starterPets],
                                    err => {
                                        if (err) {
                                            console.error(
                                                "Pet seeding failed:",
                                                err.message
                                            );
                                            process.exit(1);
                                        }

                                        startServer();
                                    }
                                );
                            }
                        );
                    }
                );
            });
        }
    );
});

process.on("SIGINT", () => {
    connection.end(() => process.exit(0));
});



